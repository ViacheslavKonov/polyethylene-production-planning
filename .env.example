# Copy values into Portainer stack environment variables. NEVER commit .env.
POSTGRES_DB=pe_planning
POSTGRES_USER=pe_planning
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
# For GitOps in Portainer, use main after GitHub Actions publishes the first image.
APP_IMAGE=ghcr.io/viacheslavkonov/polyethylene-production-planning:main
# Loopback default: expose externally only behind an authenticated TLS reverse proxy.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
